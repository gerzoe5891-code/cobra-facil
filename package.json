{
  "name": "cobra-facil-desktop",
  "productName": "Cobra Fácil",
  "version": "8.0.6",
  "description": "Sistema de gestión de clientes y cobranzas para Tu Propio Estilo",
  "author": "Tu Propio Estilo",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "npm run desktop",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron-updater": "^6.8.9",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.tupropioestilo.cobrafacil",
    "productName": "Cobra Fácil",
    "asar": true,
    "publish": [
  {
    "provider": "github",
    "owner": "gerzoe5891-code",
    "repo": "cobra-facil"
  }
],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Cobra-Facil-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Cobra Fácil",
      "uninstallDisplayName": "Cobra Fácil",
      "runAfterFinish": true
    }
  }
}
